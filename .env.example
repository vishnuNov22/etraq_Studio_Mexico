# Public URL of the deployed site (canonical URLs, hreflang, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Verified studio contact details. Leave empty until the studio confirms them:
# empty values are simply not shown anywhere on the site.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM_HANDLE=etarq.studio

# Optional: URL that receives the inquiry form as JSON (POST).
# Works with Formspree, Resend/Next route handlers, Zapier webhooks, etc.
# When empty, the form is a clearly labelled front-end prototype and never reports a fake success.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# "true" shows small "draft copy" notes where wording or project titles are still to be confirmed
# with the studio. Set to "false" once the studio has approved the content.
NEXT_PUBLIC_SHOW_DRAFT_NOTES=true
